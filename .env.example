# Pulse-HWM — environment template
# Copy this file to `.env` and fill in real values.
# `.env` is GITIGNORED. Never put real keys anywhere else.

# ── Alert webhooks (optional — leave empty to disable) ──
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ── Alert defaults (app Settings UI can override) ───────
# true / false
ALERT_SOUND_ENABLED=true

# '?' Accounts / cloud sync (PUBLIC values - not secrets - but still .env
# so you can point dev builds at a different project)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
