# ── Secrets ─────────────────────────────────────────────
.env
.env.local
*.pem
*.key

# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ── Vendored runtime bundles (fetched via scripts/lhm.py fetch) ────
pulse_hwm/assets/lhm_runtime/

# ── Build / packaging output ────────────────────────────
build/
dist/
dist*/
release/
installer/output/

# ── Local runtime data (portable mode fallback) ─────────
data/
*.db
*.sqlite3

# ── Editors / OS ────────────────────────────────────────
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# ── Claude Code / agent tooling ─────────────────────────
# .claude/settings.json (shared project permissions) is tracked; everything
# else in .claude/ is machine-local. Skills are cloned into .agents/skills
# (linked from .claude/skills) and are reproducible from skills-lock.json.
.claude/*
!.claude/settings.json
.agents/
node_modules/
.wrangler/

# ── Logs ────────────────────────────────────────────────
*.log

# cloudflare workers (wrangler artifacts)
workers/.wrangler/
workers/node_modules/
workers/.dev.vars
