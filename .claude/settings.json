{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m pytest:*)",
      "Bash(.venv/Scripts/python.exe -m pulse_hwm --selftest)",
      "Bash(.venv/Scripts/pre-commit.exe run:*)",
      "Bash(pre-commit run:*)",
      "Bash(.venv/Scripts/pyinstaller.exe pulse_hwm.spec --noconfirm)",
      "PowerShell(.venv\\Scripts\\python.exe -m pytest:*)",
      "PowerShell(.venv\\Scripts\\pre-commit.exe run:*)",
      "PowerShell(pre-commit run:*)",
      "PowerShell(.venv\\Scripts\\pyinstaller.exe pulse_hwm.spec --noconfirm)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(git add .env:*)",
      "Bash(git add -f .env:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject_handoff.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_protected_files.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_python.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
