{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m pytest:*)",
      "Bash(.venv/Scripts/python.exe -m pulse_hwm --selftest)",
      "Bash(.venv/Scripts/pre-commit.exe run:*)",
      "Bash(pre-commit run:*)",
      "Bash(.venv/Scripts/pyinstaller.exe pulse_hwm.spec --noconfirm)",
      "PowerShell(.venv\\Scripts\\python.exe -m pytest:*)",
      "PowerShell(.venv\\Scripts\\pre-commit.exe run:*)",
      "PowerShell(pre-commit run:*)",
      "PowerShell(.venv\\Scripts\\pyinstaller.exe pulse_hwm.spec --noconfirm)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(git add .env:*)",
      "Bash(git add -f .env:*)"
    ]
  }
}
