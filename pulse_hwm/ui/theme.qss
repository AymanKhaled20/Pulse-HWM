/* ── Pulse-HWM pixel theme (TEMPLATE) ──────────────────────
   This file is a template, not a raw stylesheet: every color and font
   below is filled in from the active entry in ui/palettes.py by
   theme.render_qss(). Tokens are UPPER_SNAKE names prefixed with a dollar
   sign (string.Template).
   ───────────────────────────────────────────────────────────*/

* {
    font-family: '$BODY_FONT';
    font-size: $BODY_PX;
    color: $TEXT;
    selection-background-color: $PRIMARY;
    selection-color: $BG;
}

QMainWindow, QWidget#root {
    background-color: $BG;
}

/* ── labels ─────────────────────────────────────────────── */
QLabel {
    background: transparent;
}

QLabel#title {
    font-family: '$TITLE_FONT';
    font-size: $TITLE_PX;
    color: $PRIMARY;
    letter-spacing: 2px;
}

QLabel#panelTitle {
    font-family: '$DISPLAY_FONT';
    font-size: $DISPLAY_PX;
    color: $HIGHLIGHT;
}

QLabel#stat {
    font-family: '$BODY_FONT';
    font-size: $STAT_PX;
    color: $TEXT;
}

QLabel#muted, QLabel#unit {
    color: $MUTED;
}

/* ── pixel panels ───────────────────────────────────────── */
QFrame#pixelPanel {
    background-color: $PANEL;
    border: 2px solid $LINE;
    border-radius: 0px;
}
QFrame#pixelPanel:hover {
    border-color: $PRIMARY;
}

/* ── tabs ───────────────────────────────────────────────── */
QTabWidget::pane {
    border: 2px solid $LINE;
    background: $BG;
    top: -1px;
}
QTabBar::tab {
    background: $PANEL;
    color: $MUTED;
    font-family: '$DISPLAY_FONT';
    font-size: $DISPLAY_PX;
    padding: 8px 18px;
    border: 2px solid $LINE;
    border-bottom: none;
    margin-right: 2px;
}
QTabBar::tab:selected {
    color: $BG;
    background: $PRIMARY;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    color: $HIGHLIGHT;
    border-color: $PRIMARY;
}

/* ── buttons ────────────────────────────────────────────── */
QPushButton {
    background: $PANEL;
    border: 2px solid $PRIMARY;
    color: $PRIMARY;
    font-family: '$DISPLAY_FONT';
    font-size: $DISPLAY_PX;
    padding: 7px 14px;
    border-radius: 0px;
}
QPushButton:hover {
    background: $PRIMARY;
    color: $BG;
}
QPushButton:pressed {
    background: $HIGHLIGHT;
    color: $BG;
    padding-top: 8px;
    padding-bottom: 6px;
}
QPushButton:disabled {
    border-color: $LINE;
    color: $MUTED;
    background: $PANEL;
}
QPushButton#danger {
    border-color: $DANGER;
    color: $DANGER;
}
QPushButton#danger:hover {
    background: $DANGER;
    color: $BG;
}
QPushButton#success {
    border-color: $SUCCESS;
    color: $SUCCESS;
}
QPushButton#success:hover {
    background: $SUCCESS;
    color: $BG;
}

/* ── inputs ─────────────────────────────────────────────── */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: $PANEL_ALT;
    border: 2px solid $LINE;
    color: $TEXT;
    font-family: '$BODY_FONT';
    font-size: $BODY_PX;
    padding: 4px 8px;
    border-radius: 0px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: $PRIMARY;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background: $PANEL;
    border: 2px solid $PRIMARY;
    selection-background-color: $PRIMARY;
    selection-color: $BG;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: $PANEL;
    border: 1px solid $LINE;
    width: 16px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: $PRIMARY;
}

/* ── tables ─────────────────────────────────────────────── */
QTableWidget, QTableView {
    background: $PANEL_ALT;
    border: 2px solid $LINE;
    gridline-color: $LINE;
    font-family: '$BODY_FONT';
    font-size: $TABLE_PX;
}
QHeaderView::section {
    background: $PANEL;
    color: $HIGHLIGHT;
    font-family: '$DISPLAY_FONT';
    font-size: $HEADER_PX;
    padding: 6px;
    border: 1px solid $LINE;
    border-radius: 0px;
}
QTableCornerButton::section {
    background: $PANEL;
    border: 1px solid $LINE;
}

/* ── trees (processes) ──────────────────────────────────── */
QTreeWidget {
    background: $PANEL_ALT;
    border: 2px solid $LINE;
    font-family: '$BODY_FONT';
    font-size: $TABLE_PX_LG;
}
QTreeWidget::item:selected {
    background: $PANEL;
    color: $PRIMARY;
}

/* ── scrollbars ─────────────────────────────────────────── */
QScrollBar:vertical {
    background: $BG;
    width: 14px;
    border-left: 2px solid $LINE;
}
QScrollBar::handle:vertical {
    background: $PRIMARY;
    min-height: 24px;
    border: none;
}
QScrollBar::handle:vertical:hover {
    background: $HIGHLIGHT;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: $BG;
    height: 14px;
    border-top: 2px solid $LINE;
}
QScrollBar::handle:horizontal {
    background: $PRIMARY;
    min-width: 24px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── checkboxes / toggles ───────────────────────────────── */
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background: $PANEL_ALT;
    border: 2px solid $LINE;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: $PRIMARY;
}
QCheckBox::indicator:checked {
    background: $PRIMARY;
}
QRadioButton::indicator:checked {
    background: $PRIMARY;
}
QCheckBox, QRadioButton {
    font-family: '$BODY_FONT';
    font-size: $BODY_PX;
}

/* ── menus / tray ───────────────────────────────────────── */
QMenu {
    background: $PANEL;
    border: 2px solid $PRIMARY;
    padding: 2px;
}
QMenu::item {
    font-family: '$BODY_FONT';
    font-size: $BODY_PX;
    padding: 6px 28px;
    color: $TEXT;
}
QMenu::item:selected {
    background: $PRIMARY;
    color: $BG;
}
QMenu::separator {
    height: 2px;
    background: $LINE;
    margin: 2px 6px;
}

/* ── misc ───────────────────────────────────────────────── */
QToolTip {
    background: $PANEL;
    color: $HIGHLIGHT;
    border: 1px solid $PRIMARY;
    font-family: '$BODY_FONT';
    font-size: $DISPLAY_PX;
}
QProgressBar {
    background: $PANEL_ALT;
    border: 2px solid $LINE;
    border-radius: 0px;
    text-align: center;
    font-family: '$BODY_FONT';
    color: $TEXT;
}
QProgressBar::chunk {
    background: $PRIMARY;
}
QSplitter::handle {
    background: $LINE;
}


/* === settings rail (M6 rework): section buttons track the active page === */
QPushButton#railButton {
    background-color: $PANEL;
    color: $MUTED;
    text-align: left;
    padding: 8px 10px;
    border: 2px solid $LINE;
}
QPushButton#railButton:hover {
    color: $TEXT;
    border-color: $PRIMARY;
}
QPushButton#railButton:checked {
    background-color: $PANEL_ALT;
    color: $PRIMARY;
    border-left: 4px solid $PRIMARY;
}
QPushButton#railButton:checked:hover {
    border-color: $PRIMARY;
}
