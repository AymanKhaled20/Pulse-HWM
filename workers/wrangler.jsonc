{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulsehwm-cloud",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pulsehwm-data",
      "database_id": "SET_AFTER_CREATE"
    }
  ],
  "vars": {
    // how long an access JWT lives, seconds (refresh token lives ~30 days)
    "ACCESS_TTL_S": "3600",
    "REFRESH_TTL_S": "2592000",
    "VERIFIER_TTL_S": "900"
  },
  "observability": {
    "enabled": true
  }
}
