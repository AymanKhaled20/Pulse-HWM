# Normalize line endings: LF in repo, native on checkout
* text=auto eol=lf

# Scripts must keep LF for cross-shell compatibility
*.py text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never touch
*.ttf binary
*.png binary
*.ico binary
*.wav binary
